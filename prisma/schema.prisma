generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Starter models — replace with your own
model Client {
  id                    Int                    @id @default(autoincrement())
  firstName             String
  lastName              String
  phoneMasked           String                 @unique
  tier                  Tier                   @default(FAN)
  previousTier          Tier?
  giftDone              Boolean                @default(false)
  giftStillOwed         Boolean                @default(false)
  giftEligibilityStatus GiftEligibilityStatus  @default(PENDING)
  giftDate              DateTime?
  hasLoan               Boolean                @default(false)
  loanOverdueDays       Int                    @default(0)
  pickupNotified        Boolean                @default(false)
  pickupCenter          String                 @default("Мөнгөн Завьяа зээлийн төв")
  pickupNotifiedAt      DateTime?
  isWaitlist            Boolean                @default(false)
  tierChangedAt         DateTime?
  statusReason          String                 @default("")
  note                  String                 @default("")
  giftType              String                 @default("")
  deliveredBy           String                 @default("")
  gifts                 GiftLog[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("clients")
}

model GiftLog {
  id          Int      @id @default(autoincrement())
  clientId    Int
  giftType    String
  deliveredBy String?
  note        String   @default("")
  deliveredAt DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("gift_logs")
}

model MarketingMerchItem {
  id              Int                   @id @default(autoincrement())
  name            String
  category        MerchCategory
  unit            String                @default("pcs")
  totalStock      Int                   @default(0)
  issuedStock     Int                   @default(0)
  storageLocation String                @default("")
  note            String                @default("")
  issues          MarketingMerchIssue[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([category])
  @@map("marketing_merch_items")
}

model MarketingMerchIssue {
  id            Int                @id @default(autoincrement())
  itemId        Int
  quantity      Int
  recipientName String             @default("")
  purpose       String             @default("")
  issuedBy      String             @default("")
  issuedAt      DateTime           @default(now())
  note          String             @default("")
  item          MarketingMerchItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([issuedAt])
  @@map("marketing_merch_issues")
}

enum Tier {
  GOD
  KING
  BOSS
  STAR
  FAN
}

enum GiftEligibilityStatus {
  PENDING
  DELIVERED
  REVIEW
  CLOSED
}

enum MerchCategory {
  PEN
  NOTEBOOK
  STICKER
  STUFFED_TOY
  GIFT_SET
  OTHER
}
