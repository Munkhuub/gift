generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Starter models — replace with your own
model Client {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  phoneMasked String    @unique
  tier        Tier      @default(FAN)
  giftDone    Boolean   @default(false)
  giftDate    DateTime?
  hasLoan     Boolean   @default(false)
  note        String    @default("")
  giftType    String    @default("")
  deliveredBy String    @default("")
  gifts       GiftLog[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("clients")
}

model GiftLog {
  id          Int      @id @default(autoincrement())
  clientId    Int
  giftType    String
  deliveredBy String?
  note        String   @default("")
  deliveredAt DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("gift_logs")
}

model MarketingResource {
  id           Int                     @id @default(autoincrement())
  name         String
  campaign     String                  @default("")
  resourceType MarketingResourceType
  owner        String                  @default("")
  status       MarketingResourceStatus @default(REQUESTED)
  quantity     Int?
  budget       Float?
  neededBy     DateTime?
  vendor       String                  @default("")
  note         String                  @default("")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status])
  @@index([resourceType])
  @@index([neededBy])
  @@map("marketing_resources")
}

enum Tier {
  GOD
  KING
  BOSS
  STAR
  FAN
}

enum MarketingResourceType {
  MERCH
  CREATIVE
  BUDGET
  STAFF
  CHANNEL
}

enum MarketingResourceStatus {
  REQUESTED
  IN_PROGRESS
  READY
  DEPLOYED
}
